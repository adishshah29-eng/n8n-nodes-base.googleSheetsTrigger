DATABASE_URL=postgres://user:pass@host/aotan?sslmode=require
# Certificate signing key: generate with `node scripts/gen-key.js`
ED25519_PRIVATE_KEY=
# Admin dashboard (/admin): choose a long random password and secret
ADMIN_PASSWORD=
ADMIN_JWT_SECRET=
# Optional: certificate validity in months (default 12)
CERT_VALIDITY_MONTHS=12
