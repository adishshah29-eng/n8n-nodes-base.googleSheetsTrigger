# No database to configure: storage is a SQLite file (data/aotan.db locally, /tmp on Vercel).
# DATABASE_PATH=./data/aotan.db

# Certificate signing key: generate with `node scripts/gen-key.js` (also signs device tokens)
ED25519_PRIVATE_KEY=
# Admin dashboard (/admin): choose a long random password and secret
ADMIN_PASSWORD=
ADMIN_JWT_SECRET=
# Optional: certificate validity in months (default 12)
CERT_VALIDITY_MONTHS=12
# Optional: 1 = fill a fresh database with demo data (useful on Vercel, where /tmp resets)
SEED_DEMO=0
